rules_version = '2';

// Rules are OR'd together, so the payments, rides and users blocks only hold because the catch-all
// at the bottom skips those collections. Don't add a broader match without keeping that exclusion.
service cloud.firestore {
  match /databases/{database}/documents {

    // The app's @usc.edu check only runs on the phone, so the rules repeat it. Email verification
    // is out of scope for this project, so password accounts are accepted without it.
    function isUscStudent() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.+@usc[.]edu');
    }

    function uid() {
      return request.auth.uid;
    }

    // Profiles are readable by any student (public profile view). Only the owner writes, and
    // email, USC ID, full name and graduation year are fixed after signup.
    match /users/{userId} {
      // Riders' pay links are built from these, so only the shapes the app accepts are stored
      // (same patterns as PaymentValidator). A non-string would also crash profile screens.
      function hasValidPaymentHandles() {
        let data = request.resource.data;
        return (!('venmoUsername' in data)
                || (data.venmoUsername is string
                    && data.venmoUsername.matches('[A-Za-z0-9_-]{5,30}')))
          && (!('cashtag' in data)
                || (data.cashtag is string
                    && data.cashtag.matches('[A-Za-z0-9_]{1,20}')
                    && data.cashtag.matches('.*[A-Za-z].*')));
      }

      allow read: if isUscStudent();
      allow create: if isUscStudent()
        && userId == uid()
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.uscId is string
        && request.resource.data.uscId.matches('[0-9]{10}')
        && hasValidPaymentHandles();
      allow update: if isUscStudent()
        && userId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['email', 'uscId', 'fullName', 'gradYear', 'createdAt'])
        && hasValidPaymentHandles();
      allow delete: if false;
    }

    match /rides/{rideId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isActive(status) {
        return status == 'onTime' || status == 'delayed';
      }

      // Completed and Cancelled are final. Completing waits for the (possibly delayed) departure.
      function isValidStatusChange() {
        let next = request.resource.data.status;
        return isActive(resource.data.status)
          && (next == 'onTime' || next == 'delayed' || next == 'cancelled'
              || (next == 'completed' && resource.data.departureTime <= request.time));
      }

      allow read: if isUscStudent();

      allow create: if isUscStudent()
        && request.resource.data.organizerId == uid()
        && request.resource.data.status == 'onTime'
        && request.resource.data.participantIds == [uid()]
        && request.resource.data.expectedCost is number
        && request.resource.data.expectedCost > 0
        && request.resource.data.maxRiders is int
        && request.resource.data.maxRiders >= 2
        && request.resource.data.maxRiders <= 6;

      // Leaving needs at least three hours before the current (possibly delayed) departure.
      function isBeforeLeaveCutoff() {
        return resource.data.departureTime > request.time + duration.value(3, 'h');
      }

      // The caller removes only themselves from the rider list.
      function isSelfRemoval() {
        return uid() in resource.data.participantIds
          && request.resource.data.participantIds
               == resource.data.participantIds.removeAll([uid()]);
      }

      // Organizer leaving with riders left: ownership goes to a remaining rider.
      function isOwnershipTransfer() {
        return isSelfRemoval()
          && isBeforeLeaveCutoff()
          && request.resource.data.organizerId in resource.data.participantIds
          && request.resource.data.organizerId != uid();
      }

      function addsRiders() {
        return request.resource.data.participantIds.size() > resource.data.participantIds.size();
      }

      // Posted title, locations, expected cost and max riders never change. Only the organizer
      // changes status, departure time, cost records or ownership; another rider may only remove
      // themselves (leave) before the cutoff. Riders are only added before departure. The
      // organizer may cancel an active ride at any time. Once completed/cancelled, only the
      // recorded final cost may still be written.
      allow update: if isUscStudent()
        && !changedKeys().hasAny(['title', 'origin', 'destination', 'maxRiders',
                                  'expectedCost', 'createdAt'])
        && (resource.data.organizerId == uid()
            || (changedKeys().hasOnly(['participantIds']) && isSelfRemoval() && isBeforeLeaveCutoff()))
        && (isActive(resource.data.status) || changedKeys().hasOnly(['finalCost']))
        && (!changedKeys().hasAny(['status']) || isValidStatusChange())
        && (!changedKeys().hasAny(['organizerId']) || isOwnershipTransfer())
        && (!changedKeys().hasAny(['participantIds']) || !addsRiders()
            || request.time < resource.data.departureTime);

      allow delete: if false;
    }

    // One document per person per ride, id is {rideId}_{userId}.
    match /payments/{paymentId} {

      function isMine() {
        return resource.data.userId == uid() || resource.data.organizerId == uid();
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isSplitWrite() {
        let share = request.resource.data;
        let ride = get(/databases/$(database)/documents/rides/$(share.rideId)).data;
        return paymentId == share.rideId + '_' + share.userId
          && share.keys().hasOnly(['rideId', 'userId', 'organizerId', 'rideTitle', 'amount',
                                   'paid', 'paidAt', 'assignedAt', 'flagged', 'flaggedAt'])
          && share.organizerId == uid()
          && ride.organizerId == uid()
          && ride.status == 'completed'
          && (share.userId == uid() || share.userId in ride.participantIds)
          && (share.rideTitle == null || share.rideTitle is string)
          && share.amount is number
          && share.amount >= 0
          && share.amount <= 99999.99
          && share.paid == (share.userId == uid() || share.amount == 0)
          && share.paidAt == null
          && share.assignedAt == request.time
          && share.flagged == false
          && share.flaggedAt == null;
      }

      function isMarkPaid() {
        let share = request.resource.data;
        return resource.data.userId == uid()
          && resource.data.paid == false
          && changedKeys().hasOnly(['paid', 'paidAt', 'flagged', 'flaggedAt'])
          && share.paid == true
          && share.paidAt == request.time
          && share.flagged == false
          && share.flaggedAt == null;
      }

      function isFlag() {
        let share = request.resource.data;
        return resource.data.organizerId == uid()
          && resource.data.paid == false
          && resource.data.flagged == false
          && changedKeys().hasOnly(['flagged', 'flaggedAt'])
          && request.time >= resource.data.assignedAt + duration.value(7, 'd')
          && share.flagged == true
          && share.flaggedAt == request.time;
      }

      // A missing share has to be readable too, the split transaction checks for one before
      // the first save.
      allow get: if isUscStudent() && (resource == null || isMine());
      // Flagged shares are listable by any student so the flag can show on the user's profile.
      allow list: if isUscStudent() && (isMine() || resource.data.flagged == true);
      allow create: if isUscStudent() && isSplitWrite();
      allow update: if isUscStudent()
        && ((resource.data.paidAt == null && isSplitWrite()) || isMarkPaid() || isFlag());
      allow delete: if false;
    }

    // Everything else stays open to signed-in students until its owner tightens it.
    match /{collection}/{document=**} {
      allow read, write: if isUscStudent() && collection != 'payments' && collection != 'rides'
        && collection != 'users';
    }
  }
}
