<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/profileTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Profile Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/profileNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/profileNicknameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nickname: --"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/profileEmailTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: Loading..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/profileUscIdTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USC ID: --"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/profileGradYearTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Graduation Year: --"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/profileFlagTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B3261E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/profileEditNicknameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Nickname"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileSharingHintTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your rides are private. Turn on Public to show a ride on your profile to other users."
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileRideTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Created by me" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joined" />
    </com.google.android.material.tabs.TabLayout>

    <TextView
        android:id="@+id/profileUpcomingHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upcoming Rides"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/upcomingRidesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/upcomingRidesEmptyTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No upcoming rides"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="8dp" />


    <TextView
        android:id="@+id/profileCompletedHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Completed &amp; Cancelled Rides"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/completedRidesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/completedRidesEmptyTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No completed or cancelled rides"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="8dp" />


    <Button
        android:id="@+id/profileSignOutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:layout_marginBottom="8dp" />

    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
